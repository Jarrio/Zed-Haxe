root = true

[*]
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space

[*.md]
trim_trailing_whitespace = false

[*.scm]
indent_size = 4

[*.mjs]
indent_size = 4

# The bridge follows the usual Haxe style (haxe-formatter's defaults).
[bridge/**.{hx,hxml,json}]
indent_style = tab

[languages/*/tasks.json]
indent_style = tab
