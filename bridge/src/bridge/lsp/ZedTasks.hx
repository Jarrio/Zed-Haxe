package bridge.lsp;

import bridge.project.ProjectProvider.TaskSpec;
import haxe.DynamicAccess;
import haxe.Json;
import haxe.io.Path;
import sys.FileSystem;
import sys.io.File;

enum TasksWrite {
	Written;
	Unchanged;

	/** The file exists and wasn't generated by the extension, so it was left alone. **/
	NotOurs;
}

/** The Haxe and haxelib the project's tasks should run. **/
typedef TaskToolchain = {
	final haxe:String;
	final haxelib:String;
	final env:DynamicAccess<String>;
}

/**
	Writes the project's build and run commands to `.zed/tasks.json`, where Zed's task picker
	(`task: spawn`, `task: rerun`) finds them. Only a file the extension generated is ever rewritten;
	a header comment marks it.
**/
class ZedTasks {
	static final header = [
		"// Generated by the Haxe extension from the detected project, and kept up to date when targets change.",
		"// To keep your own tasks here instead, delete these comment lines; the extension then leaves this file alone.",
		'// To stop generating it, set "project": { "tasks": false } in the haxe-language-server settings.'
	];

	public static function path(workspaceRoot:String):String {
		return Path.join([workspaceRoot, ".zed", "tasks.json"]);
	}

	public static function isGenerated(text:String):Bool {
		return StringTools.startsWith(StringTools.ltrim(text), header[0]);
	}

	/** Tasks for the current target first; `haxe`/`haxelib` replaced by the project's own. **/
	public static function render(tasks:Array<TaskSpec>, workspaceRoot:String, toolchain:TaskToolchain, currentTarget:Null<String>):String {
		final ordered = tasks.copy();
		haxe.ds.ArraySort.sort(ordered, (a, b) -> rank(a, currentTarget) - rank(b, currentTarget));
		final entries = [
			for (task in ordered) {
				final executable = switch task.command[0] {
					case "haxe": toolchain.haxe;
					case "haxelib": toolchain.haxelib;
					case other: other;
				}
				final entry:DynamicAccess<Dynamic> = {
					label: task.label,
					command: executable,
					args: task.command.slice(1),
					cwd: relativeToWorktree(task.cwd, workspaceRoot)
				};
				if (toolchain.env.keys().length > 0 && (task.command[0] == "haxe" || task.command[0] == "haxelib")) {
					entry.set("env", toolchain.env);
				}
				entry;
			}
		];
		return header.join("\n") + "\n" + Json.stringify(entries, null, "\t") + "\n";
	}

	/** Writes `content` unless the file belongs to the user or already says the same. **/
	public static function write(workspaceRoot:String, content:String):TasksWrite {
		return writeGenerated(path(workspaceRoot), content, header[0]);
	}

	/**
		Writes a generated file: only if it doesn't exist yet or starts with `firstLine`, the header that
		marks it as generated. Deleting the header makes the file the user's.
	**/
	public static function writeGenerated(file:String, content:String, firstLine:String):TasksWrite {
		if (FileSystem.exists(file)) {
			final existing = File.getContent(file);
			if (!StringTools.startsWith(StringTools.ltrim(existing), firstLine)) {
				return NotOurs;
			}
			if (existing == content) {
				return Unchanged;
			}
		}
		FileSystem.createDirectory(Path.directory(file));
		File.saveContent(file, content);
		return Written;
	}

	public static function rank(task:TaskSpec, currentTarget:Null<String>):Int {
		return task.target != null && task.target == currentTarget ? 0 : 1;
	}

	/** `$ZED_WORKTREE_ROOT/...` for folders inside the project, so the file doesn't depend on where it is checked out. **/
	static function relativeToWorktree(dir:String, workspaceRoot:String):String {
		final root = Path.removeTrailingSlashes(Path.normalize(workspaceRoot));
		final normalized = Path.removeTrailingSlashes(Path.normalize(dir));
		if (normalized == root) {
			return "$ZED_WORKTREE_ROOT";
		}
		if (StringTools.startsWith(normalized, root + "/")) {
			return "$ZED_WORKTREE_ROOT/" + normalized.substr(root.length + 1);
		}
		return dir;
	}
}
