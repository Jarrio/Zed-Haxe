package bridge.lsp;

import bridge.lsp.ZedTasks.TasksWrite;
import bridge.project.ProjectProvider.TaskSpec;
import haxe.DynamicAccess;
import haxe.Json;
import haxe.io.Path;
import sys.FileSystem;

/**
	Writes debug configurations for the project's tasks to `.zed/debug.json`, for the Haxe debugger
	extension (haxe-debug, adapter "Haxe"). Zed's debug picker (F5) only turns tasks you haven't run
	since Zed started into debug entries, but always lists debug.json; Zed hides entries whose adapter
	isn't installed. Same rules as `ZedTasks`: only a file with the header is ever rewritten.
**/
class ZedDebug {
	static final header = [
		"// Generated by the Haxe extension from the project's tasks, for the Haxe debugger extension, and kept up to date when targets change.",
		"// To keep your own debug configurations here instead, delete these comment lines; the extension then leaves this file alone.",
		'// To stop generating it, set "project": { "debugConfigurations": false } in the haxe-language-server settings.'
	];

	public static function path(workspaceRoot:String):String {
		return Path.join([workspaceRoot, ".zed", "debug.json"]);
	}

	/** One configuration per task the debugger can run, the current target's first. **/
	public static function render(tasks:Array<TaskSpec>, workspaceRoot:String, currentTarget:Null<String>):String {
		final ordered = [for (task in tasks) if (task.debug != null) task];
		haxe.ds.ArraySort.sort(ordered, (a, b) -> ZedTasks.rank(a, currentTarget) - ZedTasks.rank(b, currentTarget));
		final entries = [
			for (task in ordered) {
				final entry:DynamicAccess<Dynamic> = {label: label(task.label), adapter: "Haxe", request: "launch"};
				if (task.debug.hxml != null) {
					entry.set("hxml", task.debug.hxml);
				}
				if (task.debug.program != null) {
					entry.set("program", task.debug.program);
				}
				if (task.debug.command != null) {
					entry.set("command", task.debug.command);
				}
				// Relative to the worktree; left out for the worktree itself.
				final cwd = relativeToWorktree(task.cwd, workspaceRoot);
				if (cwd != "") {
					entry.set("cwd", cwd);
				}
				entry;
			}
		];
		return header.join("\n") + "\n" + Json.stringify(entries, null, "\t") + "\n";
	}

	/** Writes `content`, except over the user's own file; no file is created when there is nothing to debug. **/
	public static function write(workspaceRoot:String, content:String, configurations:Int):TasksWrite {
		final file = path(workspaceRoot);
		if (configurations == 0 && !FileSystem.exists(file)) {
			return Unchanged;
		}
		return ZedTasks.writeGenerated(file, content, header[0]);
	}

	/** `haxe: build.hxml` → `Debug build.hxml`, `lime: test hl` → `Debug lime test hl`. **/
	static function label(taskLabel:String):String {
		return "Debug " + (StringTools.startsWith(taskLabel, "haxe: ") ? taskLabel.substr(6) : StringTools.replace(taskLabel, ": ", " "));
	}

	static function relativeToWorktree(dir:String, workspaceRoot:String):String {
		final root = Path.removeTrailingSlashes(Path.normalize(workspaceRoot));
		final normalized = Path.removeTrailingSlashes(Path.normalize(dir));
		if (normalized == root) {
			return "";
		}
		return StringTools.startsWith(normalized, root + "/") ? normalized.substr(root.length + 1) : dir;
	}
}
