package bridge.project;

import bridge.project.ProjectProvider;
import bridge.project.ProviderDefinition;
import bridge.util.Exec;
import bridge.util.Files;
import bridge.util.Vars;
import haxe.DynamicAccess;
import haxe.Json;
import haxe.io.Path;
import js.Node.process;
import js.lib.Promise;
import sys.FileSystem;
import sys.io.File;

/**
	Runs a `ProviderDefinition`: find a marker file, run a command, read the display arguments.
**/
class CommandProvider implements ProjectProvider {
	public var name(default, null):String;
	public var priority(default, null):Int;

	final definition:ProviderDefinition;

	public function new(definition:ProviderDefinition) {
		this.definition = definition;
		name = definition.name;
		priority = definition.priority ?? 50;
	}

	public function detect(ctx:ProjectContext):Array<String> {
		return Files.findByName(ctx.projectRoot, definition.detect, 2);
	}

	public function targets(ctx:ProjectContext, file:String):Promise<Array<String>> {
		if (definition.targets != null) {
			return Promise.resolve(definition.targets);
		}
		final spec = definition.targetsCommand;
		if (spec == null) {
			return Promise.resolve([]);
		}
		final values = placeholders(ctx, file, null);
		return run(spec, values, ctx).then(function(result) {
			return [for (line in result.stdout.split("\n")) if (StringTools.trim(line) != "") StringTools.trim(line)];
		});
	}

	public function resolve(ctx:ProjectContext, file:String, target:Null<String>):Promise<ProviderResult> {
		final values = placeholders(ctx, file, target);
		final spec = definition.args;
		final cwd = Vars.expand(spec.cwd ?? "${projectDir}", values);
		final displayCwd = Vars.expand(definition.displayCwd ?? "${projectDir}", values);
		return run(spec, values, ctx).then(function(result):ProviderResult {
			final output:Dynamic = spec.output ?? "hxml";
			final parsed:ProviderResult = if (output == "json") {
				Json.parse(result.stdout);
			} else if (output == "hxml") {
				{args: Hxml.parse(result.stdout)};
			} else if (Reflect.hasField(output, "file")) {
				final path = Path.join([cwd, Vars.expand(output.file, values)]);
				if (!FileSystem.exists(path)) {
					throw '$name: expected ${path} to be generated by `${commandLine(spec, values)}`';
				}
				{args: Hxml.parse(File.getContent(path))};
			} else {
				throw '$name: unknown output kind ${Json.stringify(output)}';
			}
			if (Path.normalize(displayCwd) != Path.normalize(ctx.workspaceRoot)) {
				parsed.args = ["--cwd", displayCwd].concat(parsed.args);
			}
			if (parsed.docs == null) {
				parsed.docs = definition.docs;
			}
			return parsed;
		});
	}

	public function watch():Array<String> {
		return definition.watch ?? definition.detect;
	}

	public function tasks(ctx:ProjectContext, file:String, targets:Array<String>):Array<TaskSpec> {
		final result = [];
		final lists:DynamicAccess<Array<String>> = {
			buildTypeArgs: definition.buildTypes?.get(ctx.settings.buildType ?? "") ?? []
		};
		for (template in definition.tasks ?? []) {
			final perTarget = template.label.indexOf("${target}") >= 0 || template.command.join(" ").indexOf("${target}") >= 0;
			final forTargets:Array<Null<String>> = perTarget ? cast targets : [null];
			for (target in forTargets) {
				final values = placeholders(ctx, file, target);
				final command = Vars.expandArgs(template.command, values, lists);
				final debuggable = target != null && template.debugTargets != null
					&& template.debugTargets.map(name -> Vars.expand(name, values)).contains(target);
				result.push({
					label: Vars.expand(template.label, values),
					command: command,
					cwd: Vars.expand(template.cwd ?? "${projectDir}", values),
					target: target,
					debug: debuggable ? {command: command} : null
				});
			}
		}
		return result;
	}

	public function buildTypes():Array<String> {
		final types = definition.buildTypes == null ? [] : [for (name in definition.buildTypes.keys()) name];
		if (types.length > 0 && !types.contains("release")) {
			types.insert(types.indexOf("debug") + 1, "release");
		}
		return types;
	}

	function placeholders(ctx:ProjectContext, file:String, target:Null<String>):DynamicAccess<String> {
		return {
			workspaceRoot: ctx.workspaceRoot,
			projectDir: Path.directory(file),
			projectFile: Path.withoutDirectory(file),
			target: target ?? "",
			buildType: ctx.settings.buildType ?? "",
			hostPlatform: hostPlatform
		};
	}

	/** This machine's desktop target as Lime and Ceramic name it. **/
	public static final hostPlatform = switch process.platform {
		case "darwin": "mac";
		case "win32": "windows";
		case _: "linux";
	}

	function run(spec:CommandSpec, values:DynamicAccess<String>, ctx:ProjectContext):Promise<ExecResult> {
		final lists:DynamicAccess<Array<String>> = {
			buildTypeArgs: definition.buildTypes?.get(ctx.settings.buildType ?? "") ?? []
		};
		final alternatives = [for (command in commands(spec)) Vars.expandArgs(command, values, lists)];
		final options:ExecOptions = {
			cwd: Vars.expand(spec.cwd ?? "${projectDir}", values),
			env: ctx.env,
			aliases: ctx.settings.commands
		};
		return Exec.runFirst(alternatives, options).then(function(result) {
			if (result.code != 0) {
				throw '$name: `${alternatives[0].join(" ")}` failed with exit code ${result.code}\n${result.stderr}${result.stdout}';
			}
			return result;
		});
	}

	/** Normalises `command` to a list of alternatives. **/
	static function commands(spec:CommandSpec):Array<Array<String>> {
		if (spec.command.length > 0 && Std.isOfType(spec.command[0], Array)) {
			return cast spec.command;
		}
		return [cast spec.command];
	}

	function commandLine(spec:CommandSpec, values:DynamicAccess<String>):String {
		return Vars.expandArgs(commands(spec)[0], values).join(" ");
	}
}
