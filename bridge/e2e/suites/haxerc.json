{
	"name": ".haxerc through haxe-manager",
	"project": "${TEST_PROJECTS}/haxerc-hx",
	"open": "src/Main.hx",
	"pinHaxe": false,
	"steps": [
		{
			"name": "runs the version in .haxerc",
			"do": "log",
			"expect": {
				"contains": "(haxe-manager, 4.3.7)"
			}
		},
		{
			"name": "completion",
			"do": "completion",
			"edit": {
				"find": "\t\t\"abc\".charAt(0);",
				"replace": "\t\t\"abc\".charAt(0);\n\t\tversion.sub"
			},
			"at": "\t\tversion.sub",
			"offset": 13,
			"expect": {
				"includes": [
					"substr",
					"substring"
				]
			}
		}
	]
}
