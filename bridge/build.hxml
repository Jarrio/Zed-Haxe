# Builds bin/bridge.js, which the Rust shim embeds into the extension.
# Install dependencies once with: haxelib newrepo && haxelib install install.hxml
-lib hxnodejs
-cp src
-main bridge.Main
-D js-es=6
--dce full
--macro bridge.Embed.folder("providers")
--macro bridge.Embed.folder("docs")
-js bin/bridge.js
